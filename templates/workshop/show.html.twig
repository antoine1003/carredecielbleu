{% extends 'base.html.twig' %}
{% import 'workshop/_macros.html.twig' as ui %}

{% set settings = site_settings() %}

{% block title %}Atelier « {{ workshop.title }} » | {{ settings.siteName }}{% endblock %}
{% block description %}{{ (workshop.summary ?: (workshop.description ? workshop.description|striptags : 'Atelier de vitrail avec ' ~ settings.siteName ~ ' à ' ~ settings.city ~ '.'))|u.truncate(160, '…', false) }}{% endblock %}

{% block body %}
    <div class="container section">
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
            <ol>
                <li><a href="{{ path('app_workshops') }}">Ateliers</a></li>
                <li><span aria-current="page">{{ workshop.title }}</span></li>
            </ol>
        </nav>

        <div class="workshop">
            <div class="workshop__info stack">
                <h1 class="product__title">{{ workshop.title }}</h1>
                {% if workshop.images is not empty %}
                    <div class="workshop__gallery">
                        {{ include('partials/_gallery.html.twig', {photos: workshop.images, label: workshop.title, sizes: '(min-width: 64rem) 32rem, 92vw'}) }}
                    </div>
                {% endif %}
                {% set deposit_required = deposit_policy().isRequired(workshop) %}
                {% if workshop.duration or workshop.priceInfo or workshop.defaultLocation or deposit_required %}
                    <dl class="specs">
                        {% if workshop.duration %}<div><dt>Durée</dt><dd>{{ workshop.duration }}</dd></div>{% endif %}
                        {% if workshop.priceInfo %}<div><dt>Tarif</dt><dd>{{ workshop.priceInfo }}</dd></div>{% endif %}
                        {% if deposit_required %}<div><dt>Acompte</dt><dd>{{ (workshop.depositCents / 100)|format_currency('EUR', locale: 'fr') }}, demandé une fois la date confirmée</dd></div>{% endif %}
                        {% if workshop.defaultLocation %}<div><dt>Lieu</dt><dd>{{ workshop.defaultLocation }}</dd></div>{% endif %}
                    </dl>
                {% endif %}
                {% if workshop.description %}
                    <div class="prose">{{ workshop.description|sanitize_html('app.rich_text') }}</div>
                {% endif %}
                {% if workshop.videoUrl %}
                    {{ include('workshop/_video.html.twig', {url: workshop.videoUrl, title: workshop.title}) }}
                {% endif %}
                <p class="product__note">{{ deposit_required ? 'L\'acompte se règle en ligne sur SumUp, une fois la date confirmée.' : 'Aucun paiement n\'est demandé sur le site.' }}</p>
            </div>

            <section class="workshop__register" aria-labelledby="inscription-titre" id="inscription">
                <h2 id="inscription-titre">S'inscrire</h2>

                {{ include('partials/_flashes.html.twig') }}

                {% if result %}
                    <div class="notice {{ result.created > 0 or result.existing > 0 ? 'notice--success' }}" role="status">
                        {% if result.created > 0 or result.existing > 0 %}
                            <p><strong>Merci, votre inscription est enregistrée !</strong></p>
                            <p>Dès que la date de l'atelier sera fixée, vous recevrez un email de confirmation{{ deposit_required ? ', avec le lien pour régler l\'acompte' }}.</p>
                            {% if result.emailSent is same as(true) %}
                                <p>Un email récapitulatif vient de vous être envoyé, avec un lien pour annuler si besoin.</p>
                            {% elseif result.emailSent is same as(false) %}
                                <p>L'email récapitulatif n'a pas pu être envoyé. Votre inscription est bien enregistrée ; en cas de doute, <a href="{{ path('app_page', {slug: 'contact'}) }}">contactez-moi</a>.</p>
                            {% endif %}
                        {% endif %}
                        {% if result.unavailable is not empty %}
                            <p>{{ result.unavailable|length > 1 ? 'Certaines dates ne sont plus disponibles' : 'Une date n\'est plus disponible' }} :
                                {% for date in result.unavailable %}{{ date|format_datetime('long', 'short', locale: 'fr') }}{{ not loop.last ? ', ' }}{% endfor %}.</p>
                        {% endif %}
                    </div>
                {% endif %}

                {% if workshop.sessions is empty %}
                    <p>Aucune date n'est proposée pour le moment.</p>
                {% else %}
                    {{ form_start(form, {attr: {class: 'stack', novalidate: 'novalidate', action: path('app_workshop', {slug: workshop.slug}) ~ '#inscription'}}) }}
                        {% for error in form.vars.errors %}<p class="notice notice--error" role="alert">{{ error.message }}</p>{% endfor %}
                        <fieldset class="date-options"{% if not form.sessions.vars.valid %} aria-describedby="sessions_error"{% endif %}>
                            <legend class="date-options__legend">Dates qui vous conviennent</legend>
                            <p class="date-options__hint">Cochez toutes celles où vous êtes disponible.</p>
                            {% for error in form.sessions.vars.errors %}<p class="field__error" id="sessions_error">{{ error.message }}</p>{% endfor %}
                            {% set choices_by_value = {} %}
                            {% for child in form.sessions %}{% set choices_by_value = choices_by_value|merge({('s' ~ child.vars.value): child}) %}{% endfor %}
                            <div class="date-options__list">
                                {% for session in workshop.sessions %}
                                    {{ ui.date_tile(session, choices_by_value['s' ~ session.id] ?? null) }}
                                {% endfor %}
                            </div>
                            {% do form.sessions.setRendered() %}
                        </fieldset>

                        <div class="field-row">
                            {{ ui.field(form.firstName) }}
                            {{ ui.field(form.lastName) }}
                        </div>
                        {{ ui.field(form.email) }}
                        {{ ui.field(form.phone) }}
                        {{ ui.checkbox(form.showNamePublicly) }}
                        {{ ui.checkbox(form.consent) }}
                        <p class="field__help">Vos coordonnées servent uniquement à organiser l'atelier et sont supprimées après. <a href="{{ path('app_page', {slug: 'politique-de-confidentialite'}) }}">Politique de confidentialité</a>.</p>

                        {% if form.acceptTerms is defined %}
                            {{ include('workshop/_deposit_terms.html.twig') }}
                            {{ ui.checkbox(form.acceptTerms) }}
                        {% endif %}

                        <div class="honeypot" aria-hidden="true">
                            {{ form_label(form.website) }}
                            {{ form_widget(form.website) }}
                        </div>

                        <twig:Altcha />

                        <div><button class="btn btn--primary" type="submit">Je m'inscris à ces dates</button></div>
                    {{ form_end(form) }}
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}
