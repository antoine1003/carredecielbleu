{#
    Galerie de la fiche produit ; sans photo, illustration provisoire en verre.
    Variable : product.
#}
<div class="product__gallery">
    {% if product.images is empty %}
        <div class="lancet product__main-image">
            <twig:GlassArt :motif="glass_motif(product)" />
        </div>
    {% else %}
        {{ include('partials/_gallery.html.twig', {photos: product.images, label: product.name}) }}
    {% endif %}
</div>
