{% set route = app.request.attributes.get('_route') %}
{% set current_slug = app.request.attributes.get('slug') %}
<header class="site-header">
    <div class="container site-header__inner">
        <a class="brand" href="{{ path('app_home') }}"{% if route == 'app_home' %} aria-current="page"{% endif %}>
            <svg class="brand__mark" viewBox="0 0 34 44" aria-hidden="true" focusable="false">
                <path class="glass-art__lead glass-art__sky" d="M2 42 V17 A15 15 0 0 1 32 17 V42 Z"/>
                <path class="glass-art__lead glass-art__none" d="M2 28 H32 M17 4 V42"/>
            </svg>
            <span class="brand__name">{{ site_settings().siteName }}</span>
        </a>
        <nav class="site-nav" aria-label="Navigation principale">
            <ul class="site-nav__list">
                <li><a class="site-nav__link" href="{{ path('app_shop') }}"{% if route starts with 'app_shop' or route == 'app_product' %} aria-current="page"{% endif %}>Boutique</a></li>
                <li><a class="site-nav__link" href="{{ path('app_workshops') }}"{% if route starts with 'app_workshop' %} aria-current="page"{% endif %}>Ateliers</a></li>
                <li><a class="site-nav__link" href="{{ path('app_page', {slug: 'l-atelier'}) }}"{% if route == 'app_page' and current_slug == 'l-atelier' %} aria-current="page"{% endif %}>L'atelier</a></li>
                <li><a class="site-nav__link" href="{{ path('app_page', {slug: 'contact'}) }}"{% if route == 'app_page' and current_slug == 'contact' %} aria-current="page"{% endif %}>Contact</a></li>
            </ul>
        </nav>
    </div>
</header>
