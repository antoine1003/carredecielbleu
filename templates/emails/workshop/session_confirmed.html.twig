{% extends 'emails/_layout.html.twig' %}

{% block subject %}C'est confirmé : atelier « {{ workshop.title }} »{% endblock %}

{% block content %}
    <p style="margin:0 0 16px;">Bonjour {{ firstName }},</p>
    <p style="margin:0 0 16px;">Bonne nouvelle : l'atelier <strong>« {{ workshop.title }} »</strong> aura bien lieu à la date que vous aviez choisie.</p>
    <p style="margin:0 0 16px; padding:16px; background:{{ mail.mist }}; border-radius:8px;">
        {{ include('emails/workshop/_session.html.twig') }}
    </p>
    {% if workshop.duration %}<p style="margin:0 0 16px;">Durée : {{ workshop.duration }}.</p>{% endif %}
    {% if deposit_policy().isRequired(workshop) %}
        {{ include('emails/workshop/_deposit.html.twig') }}
    {% endif %}
    {% if workshop.priceInfo %}<p style="margin:0 0 16px;">Tarif : {{ workshop.priceInfo }}.{% if not deposit_policy().isRequired(workshop) %} Aucun paiement n'est demandé sur le site.{% endif %}</p>{% endif %}
    <p style="margin:0 0 16px;">Un empêchement ? Prévenez-moi en <a href="{{ cancelUrl }}" style="color:{{ mail.link }};">annulant votre inscription</a>, la place pourra profiter à quelqu'un d'autre.</p>
    <p style="margin:0;">À très bientôt à l'atelier,<br>{{ site_settings().siteName }}</p>
{% endblock %}
