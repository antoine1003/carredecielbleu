{#
    Inscription à la newsletter (Brevo). Variables :
    - variant = 'banner' (accueil) | 'compact' (pied de page) ;
    - message = {type: 'success'|'error', text} et email : fournis par la réponse Turbo Stream
      (sans JavaScript, le message vient des flashes après redirection).
    Affiché seulement si la newsletter est activée et configurée (newsletter_available()).
#}
{% set settings = site_settings() %}
{% set variant = variant|default('banner') %}
{% set field_id = 'newsletter-email-' ~ variant %}
{% set message = message|default(null) %}
{% if message is null %}
    {% for type, texts in app.flashes(['newsletter_success', 'newsletter_error']) %}
        {% for text in texts %}{% set message = {type: type == 'newsletter_error' ? 'error' : 'success', text: text} %}{% endfor %}
    {% endfor %}
{% endif %}
<section class="newsletter newsletter--{{ variant }}" id="newsletter" aria-labelledby="newsletter-title-{{ variant }}">
    {% if variant == 'banner' %}<twig:Shards class="newsletter__shards" />{% endif %}
    <div class="newsletter__text">
        {% if variant == 'banner' %}
            <h2 class="newsletter__title" id="newsletter-title-{{ variant }}">{{ settings.newsletterTitle }}</h2>
        {% else %}
            <p class="newsletter__title" id="newsletter-title-{{ variant }}">{{ settings.newsletterTitle }}</p>
        {% endif %}
        <p class="newsletter__intro">{{ settings.newsletterText }}</p>
    </div>

    {% if message and message.type == 'success' %}
        {# Inscription réussie : le formulaire laisse place au remerciement #}
        <p class="newsletter__form newsletter__message newsletter__message--success" role="status" tabindex="-1" data-controller="autofocus">
            <svg class="btn__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="M3 8.5 6.5 12 13 4"/></svg>
            {{ message.text }}
        </p>
    {% else %}
        <form class="newsletter__form" method="post" action="{{ path('app_newsletter_subscribe') }}">
            {% if message %}
                <p class="newsletter__message newsletter__message--error" role="alert">{{ message.text }}</p>
            {% endif %}
            <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}">
            <input type="hidden" name="back" value="{{ back|default(app.request.pathInfo) }}">
            <input type="hidden" name="variant" value="{{ variant }}">
            <div class="newsletter__row">
                <label class="visually-hidden" for="{{ field_id }}">Votre adresse email</label>
                <input class="field__input newsletter__input" id="{{ field_id }}" type="email" name="email" required maxlength="180"
                       value="{{ email|default('') }}" autocomplete="email" placeholder="Votre adresse email"
                       aria-describedby="newsletter-note-{{ variant }}"{% if message %} aria-invalid="true" data-controller="autofocus"{% endif %}>
                <button class="btn {{ variant == 'banner' ? 'btn--light' : 'btn--primary' }}" type="submit">M'abonner</button>
            </div>
            <twig:Altcha display="invisible" />
            <div class="honeypot" aria-hidden="true">
                <label for="newsletter-website-{{ variant }}">Ne pas remplir ce champ</label>
                <input id="newsletter-website-{{ variant }}" type="text" name="website" tabindex="-1" autocomplete="off">
            </div>
            <p class="newsletter__note" id="newsletter-note-{{ variant }}">
                Désinscription en un clic dans chaque email. <a href="{{ path('app_page', {slug: 'politique-de-confidentialite'}) }}">Confidentialité</a>
            </p>
        </form>
    {% endif %}
</section>
