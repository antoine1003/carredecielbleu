{% extends 'base.html.twig' %}

{% block title %}{{ page.title }} | {{ site_settings().siteName }}{% endblock %}
{% block description %}{{ page.metaDescription ?: (page.content ? page.content|striptags|u.truncate(160, '…', false) : page.title) }}{% endblock %}

{% block body %}
    <div class="container section">
        <article class="page stack">
            <h1 class="page-title">{{ page.title }}</h1>
            {% if page.content %}
                <div class="prose">{{ page.content|sanitize_html('app.rich_text') }}</div>
            {% endif %}
        </article>
    </div>
{% endblock %}
