<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Carré de ciel bleu{% endblock %}</title>
        {% block meta %}{% endblock %}
        <link rel="preload" href="{{ asset('fonts/gloock-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/nunito-sans-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        {{ include('partials/_header.html.twig') }}
        <main id="contenu" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
        {{ include('partials/_footer.html.twig') }}
    </body>
</html>
