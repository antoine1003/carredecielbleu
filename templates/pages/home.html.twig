{% extends 'base.html.twig' %}

{% set settings = site_settings() %}

{% block title %}{{ settings.siteName }}, vitraux faits main à {{ settings.city }}{% endblock %}

{% block body %}
    <div class="container">
        <section class="hero" aria-labelledby="accueil-titre">
            <twig:Shards />
            <div class="hero__text stack">
                <h1 id="accueil-titre" class="hero__title">{{ settings.homeTitle }}</h1>
                <p class="hero__lead">{{ settings.homeIntro }}</p>
                <div class="cluster">
                    <a class="btn btn--primary" href="{{ path('app_shop') }}">Voir la boutique</a>
                    <a class="btn btn--text" href="{{ path('app_page', {slug: 'l-atelier'}) }}">Découvrir l'atelier</a>
                </div>
            </div>
            <div class="hero__art hero__art--logo">
                <img src="{{ asset('images/logo-640.webp') }}"
                     srcset="{{ asset('images/logo-320.webp') }} 320w, {{ asset('images/logo-640.webp') }} 640w"
                     sizes="(min-width: 48rem) 24rem, 75vw"
                     width="640" height="640" alt="" fetchpriority="high" decoding="async">
            </div>
        </section>

        {% if selection is not empty %}
            <section class="section" aria-labelledby="accueil-creations">
                <div class="section__head">
                    <h2 id="accueil-creations">Créations disponibles</h2>
                    <a class="btn btn--text" href="{{ path('app_shop') }}">Toute la boutique</a>
                </div>
                <div class="grid-cards">
                    {% for view in selection %}
                        {{ include('shop/_card.html.twig') }}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if newsletter_available() %}
            <div class="section">{{ include('partials/_newsletter.html.twig', {variant: 'banner'}) }}</div>
        {% endif %}
    </div>
{% endblock %}
