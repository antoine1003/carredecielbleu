{# Carte produit à partir d'une ProductView (variables : view, headingLevel facultatif) #}
<twig:ProductCard
    :name="view.product.name"
    :url="path('app_product', {slug: view.product.slug})"
    :price="view.price"
    :fromPrice="view.fromPrice"
    :status="view.availability.value"
    :purchaseUrl="view.canBuy ? view.product.purchaseUrl : null"
    :image="image_attrs(view.product.images.first ?: null)"
    :motif="glass_motif(view.product)"
    :headingLevel="headingLevel ?? 3"
/>
