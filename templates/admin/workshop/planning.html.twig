{% extends '@EasyAdmin/page/content.html.twig' %}
{% import 'admin/workshop/_macros.html.twig' as when %}

{#
    Suivi d'un atelier : bandeau « où en est-on », dates proposées avec jauge de remplissage
    et bouton « Retenir cette date », puis dates passées et tableau détaillé (repliés).
    Variables : workshop, summary (WorkshopSummary), sessions, people.
#}

{% set status_colors = {open: 'info', confirmed: 'success', full: 'warning', cancelled: 'secondary'} %}

{% block page_title %}{{ workshop.title }}{% endblock %}
{% block content_title %}{{ workshop.title }}{% endblock %}

{% block page_actions %}
    <a class="btn btn-secondary" href="{{ path('admin_workshop_edit', {entityId: workshop.id}) }}"><i class="fa fa-pen"></i> Modifier l'atelier</a>
    {% if workshop.published %}
        <a class="btn btn-secondary" href="{{ path('app_workshop', {slug: workshop.slug}) }}" target="_blank" rel="noopener"><i class="fa fa-arrow-up-right-from-square"></i> Voir sur le site</a>
    {% endif %}
{% endblock %}

{% block main %}
<div class="ws">

    {# ---------- Où en est-on ? ---------- #}
    {% if summary.confirmed %}
        {% set c = summary.confirmed %}
        <section class="ws-banner ws-banner--confirmed" aria-labelledby="ws-banner-title">
            <div class="ws-banner__icon" aria-hidden="true"><i class="fa fa-calendar-check"></i></div>
            <div class="ws-banner__body">
                <p class="ws-banner__kicker">L'atelier aura lieu le</p>
                <h2 class="ws-banner__title" id="ws-banner-title">{{ when.day(c.session.startsAt)|capitalize }}</h2>
                <p class="ws-banner__meta">
                    {{ when.hours(c.session) }}{% if c.session.effectiveLocation %} · {{ c.session.effectiveLocation }}{% endif %}
                    · <strong>{{ c.registered }} participant{{ c.registered > 1 ? 's' }}</strong> sur {{ c.capacity }} places
                </p>
                {% set policy = deposit_policy() %}
                {% set with_deposit = policy.isRequired(workshop) %}
                {% set unpaid = c.registered - c.depositsPaid %}
                {% if with_deposit and c.registered > 0 %}
                    <p class="ws-banner__meta">
                        <i class="fa fa-euro-sign" aria-hidden="true"></i>
                        <strong>{{ c.depositsPaid }} acompte{{ c.depositsPaid > 1 ? 's' }} reçu{{ c.depositsPaid > 1 ? 's' }} sur {{ c.registered }}</strong>
                        {% if unpaid > 0 and policy.paymentDeadline(c.session) %} · à payer avant le {{ policy.paymentDeadline(c.session)|format_date(pattern: 'EEEE d MMMM', locale: 'fr') }}{% endif %}
                        {% if not workshop.depositUrl %} · <span class="text-danger">lien de paiement SumUp manquant : <a href="{{ path('admin_workshop_edit', {entityId: workshop.id}) }}#tab-infos-pratiques">l'ajouter</a></span>{% endif %}
                    </p>
                {% endif %}
                {% if c.session.registrations is not empty %}
                    <ul class="ws-people ws-people--contacts">
                        {% for r in c.session.registrations %}
                            <li>
                                <a href="{{ path('admin_registration_edit', {entityId: r.id}) }}">{{ r.firstName }} {{ r.lastName }}</a>
                                <span>{{ r.email }}{% if r.phone %} · {{ r.phone }}{% endif %}</span>
                                {% if with_deposit %}
                                    {% if r.depositPaid %}
                                        <twig:ea:Badge color="success" icon="fa fa-check">Acompte reçu le {{ r.depositPaidAt|format_date(pattern: 'd MMM', locale: 'fr') }}</twig:ea:Badge>
                                    {% elseif policy.isLate(r) %}
                                        <twig:ea:Badge color="danger">Acompte en retard</twig:ea:Badge>
                                    {% else %}
                                        <twig:ea:Badge color="warning">Acompte en attente</twig:ea:Badge>
                                    {% endif %}
                                    {% if r.depositReminderSentAt and not r.depositPaid %}<span>relancé le {{ r.depositReminderSentAt|format_date(pattern: 'd MMM', locale: 'fr') }}</span>{% endif %}
                                    <form method="post" action="{{ path('admin_registration_deposit', {id: r.id}) }}" class="ws-deposit-toggle">
                                        <input type="hidden" name="_token" value="{{ csrf_token('deposit' ~ r.id) }}">
                                        <button type="submit" class="btn btn-sm {{ r.depositPaid ? 'btn-link' : 'btn-secondary' }}"{% if not r.depositPaid %} title="Note l'acompte comme reçu et envoie à la personne un email : inscription validée"{% endif %}>{{ r.depositPaid ? 'Annuler' : 'Acompte reçu' }}</button>
                                    </form>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="ws-banner__actions">
                        <a class="btn btn-primary" href="mailto:?bcc={{ c.session.registrations|map(r => r.email)|join(',')|url_encode }}"><i class="fa fa-envelope"></i> Écrire aux participants</a>
                        {% if with_deposit and unpaid > 0 %}
                            <form method="post" action="{{ path('admin_workshop_session_deposit_reminders', {id: c.session.id}) }}" onsubmit="return confirm('Envoyer un email de relance aux {{ unpaid }} personne(s) dont l\'acompte n\'est pas arrivé ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('deposit_reminders' ~ c.session.id) }}">
                                <button type="submit" class="btn btn-secondary"><i class="fa fa-bell"></i> Relancer {{ unpaid > 1 ? 'les ' ~ unpaid ~ ' personnes' : 'la personne' }} sans acompte</button>
                            </form>
                        {% endif %}
                        <a class="btn btn-secondary" href="{{ path('admin_workshop_export', {id: workshop.id}) }}"><i class="fa fa-file-csv"></i> Télécharger la liste</a>
                    </div>
                {% endif %}
            </div>
        </section>
    {% elseif summary.state.value == 'to_decide' %}
        <section class="ws-banner ws-banner--decide" aria-labelledby="ws-banner-title">
            <div class="ws-banner__icon" aria-hidden="true"><i class="fa fa-hand-pointer"></i></div>
            <div class="ws-banner__body">
                <p class="ws-banner__kicker">Date à choisir</p>
                <h2 class="ws-banner__title" id="ws-banner-title">{{ when.people(summary.peopleCount)|capitalize }} inscrite{{ summary.peopleCount > 1 ? 's' }} : choisissez la date de l'atelier</h2>
                {% if summary.mostRequested %}
                    {% set top = summary.mostRequested %}
                    <p class="ws-banner__meta">La date qui réunit le plus de monde : <strong>{{ when.short(top.session.startsAt) }}</strong>, avec {{ when.people(top.registered) }}.</p>
                    <p class="ws-banner__actions">
                        <twig:ea:Modal:Trigger target="#ws-confirm-{{ top.session.id }}" variant="primary" icon="fa fa-check">Retenir cette date</twig:ea:Modal:Trigger>
                    </p>
                {% endif %}
            </div>
        </section>
    {% elseif summary.state.value == 'waiting' %}
        <section class="ws-banner ws-banner--waiting" aria-labelledby="ws-banner-title">
            <div class="ws-banner__icon" aria-hidden="true"><i class="fa fa-hourglass-half"></i></div>
            <div class="ws-banner__body">
                <p class="ws-banner__kicker">En attente d'inscriptions</p>
                <h2 class="ws-banner__title" id="ws-banner-title">Personne n'est encore inscrit</h2>
                <p class="ws-banner__meta">
                    {% if workshop.published %}
                        Les dates sont en ligne : partagez la page de l'atelier pour faire venir du monde.
                    {% else %}
                        L'atelier n'est pas encore publié : personne ne peut le voir sur le site.
                        <a href="{{ path('admin_workshop_edit', {entityId: workshop.id}) }}">Le publier</a>.
                    {% endif %}
                </p>
            </div>
        </section>
    {% else %}
        <section class="ws-banner ws-banner--empty" aria-labelledby="ws-banner-title">
            <div class="ws-banner__icon" aria-hidden="true"><i class="fa fa-calendar-plus"></i></div>
            <div class="ws-banner__body">
                <p class="ws-banner__kicker">Aucune date à venir</p>
                <h2 class="ws-banner__title" id="ws-banner-title">Proposez des dates pour ouvrir les inscriptions</h2>
                <p class="ws-banner__actions">
                    <a class="btn btn-primary" href="{{ path('admin_workshop_edit', {entityId: workshop.id}) }}#tab-dates"><i class="fa fa-plus"></i> Ajouter des dates</a>
                </p>
            </div>
        </section>
    {% endif %}

    {# ---------- Dates à venir ---------- #}
    {% if summary.upcoming is not empty %}
        <section class="ws-section" aria-labelledby="ws-dates-title">
            <div class="ws-section__head">
                <h2 id="ws-dates-title">Dates proposées</h2>
                <a class="btn btn-secondary btn-sm" href="{{ path('admin_workshop_edit', {entityId: workshop.id}) }}#tab-dates"><i class="fa fa-plus"></i> Ajouter ou modifier des dates</a>
            </div>

            <ol class="ws-dates">
                {% for s in summary.upcoming %}
                    {% set status = s.session.status.value %}
                    {% set is_top = summary.mostRequested and summary.mostRequested.session is same as(s.session) %}
                    <li class="ws-date ws-date--{{ status }}{{ is_top ? ' ws-date--top' }}">
                        <div class="ws-date__cal" aria-hidden="true">
                            <span class="ws-date__month">{{ s.session.startsAt|format_date(pattern: 'MMM', locale: 'fr')|trim('.') }}</span>
                            <span class="ws-date__day">{{ s.session.startsAt|format_date(pattern: 'd', locale: 'fr') }}</span>
                            <span class="ws-date__weekday">{{ s.session.startsAt|format_date(pattern: 'EEE', locale: 'fr') }}</span>
                        </div>

                        <div class="ws-date__main">
                            <h3 class="ws-date__when">
                                {{ when.day(s.session.startsAt)|capitalize }}
                                <span>{{ when.hours(s.session) }}</span>
                            </h3>
                            {% if s.session.effectiveLocation %}<p class="ws-date__place"><i class="fa fa-location-dot" aria-hidden="true"></i> {{ s.session.effectiveLocation }}</p>{% endif %}

                            <div class="ws-gauge" role="img" aria-label="{{ s.registered }} inscrits sur {{ s.capacity }} places">
                                <span class="ws-gauge__bar" style="width: {{ s.fillPercent }}%"></span>
                            </div>
                            <p class="ws-date__count"><strong>{{ s.registered }}</strong> inscrit{{ s.registered > 1 ? 's' }} sur {{ s.capacity }} places</p>

                            {% if s.session.registrations is not empty %}
                                <ul class="ws-people">
                                    {% for r in s.session.registrations %}
                                        <li><a href="{{ path('admin_registration_edit', {entityId: r.id}) }}" title="{{ r.email }}{{ r.phone ? ' · ' ~ r.phone }}">{{ r.firstName }} {{ r.lastName }}</a></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>

                        <div class="ws-date__side">
                            {% if status == 'confirmed' %}
                                <twig:ea:Badge color="success" icon="fa fa-check">Date retenue</twig:ea:Badge>
                            {% else %}
                                <twig:ea:Badge color="{{ status_colors[status] }}">{{ s.session.status.label }}</twig:ea:Badge>
                            {% endif %}
                            {% if is_top %}<span class="ws-date__hint"><i class="fa fa-star" aria-hidden="true"></i> La plus demandée</span>{% endif %}
                            {% if s.canConfirm and not summary.confirmed %}
                                <twig:ea:Modal:Trigger target="#ws-confirm-{{ s.session.id }}" variant="{{ is_top ? 'primary' : 'default' }}">Retenir cette date</twig:ea:Modal:Trigger>
                            {% endif %}
                            <a class="ws-date__edit" href="{{ path('admin_workshop_session_edit', {entityId: s.session.id}) }}">Modifier cette date</a>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        </section>

        {# Fenêtres de confirmation, une par date que l'on peut retenir #}
        {% for s in summary.upcoming|filter(s => s.canConfirm and not summary.confirmed) %}
            {% set form_id = 'ws-confirm-form-' ~ s.session.id %}
            <twig:ea:Modal id="ws-confirm-{{ s.session.id }}" size="lg" topIcon="fa fa-calendar-check" title="Retenir le {{ when.short(s.session.startsAt) }} ?">
                <twig:block name="body">
                    {% import 'admin/workshop/_macros.html.twig' as when %}
                    <form id="{{ outerScope.form_id }}" method="post" action="{{ path('admin_workshop_session_confirm', {id: outerScope.s.session.id}) }}" class="ws-confirm">
                        <input type="hidden" name="_token" value="{{ csrf_token('confirm_session' ~ outerScope.s.session.id) }}">
                        <p>Voici ce qui va se passer :</p>
                        <ul>
                            <li><strong>{{ when.people(outerScope.s.registered)|capitalize }}</strong> inscrite{{ outerScope.s.registered > 1 ? 's' }} à cette date {{ outerScope.s.registered > 1 ? 'recevront' : 'recevra' }} un email : l'atelier est confirmé.{% if deposit_policy().isRequired(outerScope.workshop) %} Il contiendra le lien pour payer l'acompte de {{ (outerScope.workshop.depositCents / 100)|format_currency('EUR', locale: 'fr') }}{% if not outerScope.workshop.depositUrl %} <strong class="text-danger">(lien SumUp pas encore renseigné sur l'atelier)</strong>{% endif %}.{% endif %}</li>
                            {% if outerScope.s.othersToNotify > 0 %}
                                <li><strong>{{ when.people(outerScope.s.othersToNotify)|capitalize }}</strong> inscrite{{ outerScope.s.othersToNotify > 1 ? 's' }} seulement à d'autres dates {{ outerScope.s.othersToNotify > 1 ? 'recevront' : 'recevra' }} un email pour {{ outerScope.s.othersToNotify > 1 ? 'les' : 'la' }} prévenir.</li>
                            {% endif %}
                        </ul>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="cancel_others" value="1" id="cancel-others-{{ outerScope.s.session.id }}" checked>
                            <label class="form-check-label" for="cancel-others-{{ outerScope.s.session.id }}">Ne plus proposer les autres dates (elles passent en « Annulée »)</label>
                        </div>
                        <p class="ws-confirm__warning">Les emails partent tout de suite : cette action ne peut pas être annulée.</p>
                    </form>
                </twig:block>
                <twig:block name="footer">
                    <twig:ea:Modal:Close>Pas maintenant</twig:ea:Modal:Close>
                    <button type="submit" form="{{ outerScope.form_id }}" class="btn btn-primary"><i class="fa fa-check"></i> Oui, retenir cette date</button>
                </twig:block>
            </twig:ea:Modal>
        {% endfor %}
    {% endif %}

    {# ---------- Dates passées ---------- #}
    {% if summary.past is not empty %}
        <details class="ws-more">
            <summary>Dates passées ({{ summary.past|length }})</summary>
            <ul class="ws-past">
                {% for s in summary.past %}
                    <li>
                        {{ when.day(s.session.startsAt)|capitalize }}, {{ when.hours(s.session) }}
                        · {{ s.registered }} inscrit{{ s.registered > 1 ? 's' }}
                        · <twig:ea:Badge color="{{ status_colors[s.session.status.value] }}">{{ s.session.status.value == 'confirmed' ? 'A eu lieu' : s.session.status.label }}</twig:ea:Badge>
                    </li>
                {% endfor %}
            </ul>
        </details>
    {% endif %}

    {# ---------- Tableau détaillé : qui est disponible à quelle date ---------- #}
    {% if people is not empty %}
        <details class="ws-more">
            <summary>Qui est disponible à quelle date ? (tableau détaillé)</summary>
            <div class="table-responsive">
                <table class="table datagrid">
                    <caption class="visually-hidden">Disponibilités de chaque personne pour l'atelier {{ workshop.title }}</caption>
                    <thead>
                        <tr>
                            <th scope="col">Personne</th>
                            {% for session in sessions %}
                                <th scope="col" class="text-center">{{ session.startsAt|format_date(pattern: 'EEE d MMM', locale: 'fr') }}<br><span class="small text-muted">{{ when.hours(session) }}</span></th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for person in people %}
                            <tr>
                                <th scope="row">
                                    <a href="{{ path('admin_registration_edit', {entityId: person.registration.id}) }}">{{ person.registration.firstName }} {{ person.registration.lastName }}</a>
                                    <div class="small text-muted">{{ person.registration.email }}{% if person.registration.phone %} · {{ person.registration.phone }}{% endif %}</div>
                                </th>
                                {% for session in sessions %}
                                    <td class="text-center">
                                        {% if person.sessions[session.id] ?? false %}
                                            <i class="fa fa-check text-success" aria-hidden="true"></i><span class="visually-hidden">disponible</span>
                                        {% else %}
                                            <span aria-hidden="true">—</span><span class="visually-hidden">non</span>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <p><a class="btn btn-secondary btn-sm" href="{{ path('admin_workshop_export', {id: workshop.id}) }}"><i class="fa fa-file-csv"></i> Télécharger toutes les inscriptions (CSV)</a></p>
        </details>
    {% endif %}
</div>
{% endblock %}
