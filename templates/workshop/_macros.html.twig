{# Champ de formulaire accessible, aux styles du design system (.field) #}
{% macro field(child) %}
    {% set error_id = child.vars.id ~ '_error' %}
    {% set help_id = child.vars.id ~ '_help' %}
    {% set invalid = not child.vars.valid %}
    {% set described = [child.vars.help ? help_id : null, invalid ? error_id : null]|filter(v => v)|join(' ') %}
    <div class="field{{ invalid ? ' field--invalid' }}">
        {{ form_label(child, null, {label_attr: {class: 'field__label'}}) }}
        {% if child.vars.help %}<p class="field__help" id="{{ help_id }}">{{ child.vars.help }}</p>{% endif %}
        {{ form_widget(child, {attr: child.vars.attr|merge({class: 'field__input'}|merge(described ? {'aria-describedby': described} : {})|merge(invalid ? {'aria-invalid': 'true'} : {}))}) }}
        {% for error in child.vars.errors %}<p class="field__error" id="{{ error_id }}">{{ error.message }}</p>{% endfor %}
    </div>
{% endmacro %}

{# Case à cocher avec texte long #}
{% macro checkbox(child) %}
    {% set error_id = child.vars.id ~ '_error' %}
    <div class="field{{ not child.vars.valid ? ' field--invalid' }}">
        <label class="checkbox" for="{{ child.vars.id }}">
            {{ form_widget(child, {attr: child.vars.attr|merge(not child.vars.valid ? {'aria-invalid': 'true', 'aria-describedby': error_id} : {})}) }}
            <span>{{ child.vars.label }}</span>
        </label>
        {% for error in child.vars.errors %}<p class="field__error" id="{{ error_id }}">{{ error.message }}</p>{% endfor %}
    </div>
{% endmacro %}

{# Description publique d'une date : jour, horaire, lieu #}
{% macro session_when(session) %}
    {{- session.startsAt|format_datetime('full', 'short', locale: 'fr')|capitalize -}}
    {%- if session.endsAt %} – {{ session.endsAt|format_datetime('none', 'short', locale: 'fr') }}{% endif -%}
{% endmacro %}

{# « 14 h – 17 h 30 » : minutes affichées seulement si elles ne sont pas nulles #}
{% macro hours(session) %}
    {{- session.startsAt|format_time(pattern: session.startsAt|date('i') == '00' ? "H' h'" : "H' h 'mm", locale: 'fr') -}}
    {%- if session.endsAt %} – {{ session.endsAt|format_time(pattern: session.endsAt|date('i') == '00' ? "H' h'" : "H' h 'mm", locale: 'fr') }}{% endif -%}
{% endmacro %}

{#
    Date proposée dans le formulaire d'inscription : tuile cliquable avec mini-calendrier,
    horaire, lieu, places (une pastille par place) et inscrits. child = case du formulaire,
    null si la date n'accepte plus d'inscription (complète).
#}
{% macro date_tile(session, child) %}
    {% import _self as ui %}
    {% set count = session_count(session) %}
    {% set remaining = session_remaining(session) %}
    {% set capacity = session.effectiveCapacity %}
    {% set names = session_public_names(session) %}
    {% set full = child is null %}
    {% set tag = full ? 'div' : 'label' %}
    <{{ tag }} class="date-tile{{ full ? ' date-tile--full' }}"{% if not full %} for="{{ child.vars.id }}"{% else %} aria-disabled="true"{% endif %}>
        {% if not full %}{{ form_widget(child, {attr: {class: 'date-tile__input'}}) }}{% endif %}
        <span class="date-tile__cal" aria-hidden="true">
            <small>{{ session.startsAt|format_date(pattern: 'MMM', locale: 'fr') }}</small>
            <b>{{ session.startsAt|format_date(pattern: 'd', locale: 'fr') }}</b>
            <em>{{ session.startsAt|format_date(pattern: 'EEE', locale: 'fr') }}</em>
        </span>
        <span class="date-tile__body">
            <span class="date-tile__day">
                {{- session.startsAt|format_date(pattern: 'EEEE d MMMM', locale: 'fr')|capitalize -}}
                {%- if session.startsAt|date('Y') != 'now'|date('Y') %} {{ session.startsAt|date('Y') }}{% endif -%}
            </span>
            <span class="date-tile__meta">{{ ui.hours(session) }}{% if session.effectiveLocation %} · {{ session.effectiveLocation }}{% endif %}</span>
            {% if full %}
                <span class="date-tile__meta"><strong>Complet</strong></span>
            {% else %}
                <span class="date-tile__meta">
                    {% if capacity <= 12 %}
                        <span class="seats" aria-hidden="true">{% for i in 1..capacity %}<i{{ i <= count ? ' class="seats__taken"' }}></i>{% endfor %}</span>
                    {% endif %}
                    {{ remaining }} place{{ remaining > 1 ? 's' }} restante{{ remaining > 1 ? 's' }}
                    · {% if count == 0 %}personne pour l'instant{% else %}{{ count }} inscrite{{ count > 1 ? 's' }}{% if names is not empty %} ({{ names|join(', ') }}){% endif %}{% endif %}
                </span>
            {% endif %}
            {% if session.status.value == 'confirmed' %}
                <span class="date-tile__tag">Date confirmée : l'atelier aura lieu</span>
            {% endif %}
        </span>
        {% if not full %}
            <span class="date-tile__check" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7"/></svg>
            </span>
        {% endif %}
    </{{ tag }}>
{% endmacro %}
